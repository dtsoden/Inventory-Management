# Generate with: openssl rand -hex 32
# This key encrypts all sensitive data in the database (API keys, SMTP credentials, etc.)
# Store it somewhere safe. If you lose it, encrypted data in the database is unrecoverable.
VAULT_KEY=your-64-character-hex-key-here

# Public marketing landing page (optional).
# Set LANDING=1 to show the public landing page at the site root for signed-out
# visitors, with a link through to the sign-in screen; signing out returns here too.
# Any other value, including 0 or omitting the line entirely, keeps it hidden and
# sends visitors straight to the sign-in screen (the original behavior).
LANDING=0
